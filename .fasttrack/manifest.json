{
  "fasttrack_version": "1.0.0",
  "modules": [
    {
      "id": "ces-dashboard",
      "name": "CES Dashboard - Creative Effectiveness System",
      "version": "1.3.0",
      "category": "AI Analytics Dashboard",
      "status": "production",
      "description": "Enterprise-grade AI analytics dashboard for campaign scoring, prompt-based insight generation, and demographic breakdowns",
      "paths": [
        "ces-dashboard/**",
        "specs/ces.yaml"
      ],
      "urls": {
        "production": "https://ces-mvp.vercel.app",
        "staging": "https://ces-staging.vercel.app",
        "development": "http://localhost:3001"
      },
      "features": [
        "SHAP model visualization",
        "Ask CES prompt chat",
        "Creative effectiveness scoring",
        "Demographic segment analysis",
        "Campaign lifecycle tracking",
        "Hybrid scoring methodology"
      ],
      "tech_stack": [
        "Next.js 14",
        "React 18",
        "TypeScript",
        "Tailwind CSS",
        "Zustand",
        "Recharts"
      ],
      "dependencies": {
        "internal": [
          "hybrid-ces-integration",
          "schema-mapper"
        ],
        "external": [
          "supabase",
          "vercel"
        ]
      },
      "build": {
        "command": "npm run build",
        "output": ".next",
        "size_limit": "1MB"
      },
      "quality_gates": {
        "lighthouse_score": 90,
        "test_coverage": 80,
        "bundle_size": "1MB",
        "load_time": "3s"
      },
      "fasttrack_metadata": {
        "created_at": "2024-01-16T00:00:00Z",
        "last_updated": "2024-01-16T00:00:00Z",
        "maintainers": [
          "InsightPulseAI",
          "TBWA\\SMP"
        ],
        "tags": [
          "ces",
          "dashboard",
          "ai-analytics",
          "creative-effectiveness",
          "campaign-analysis"
        ]
      }
    }
  ],
  "integration": {
    "ci_cd": {
      "workflow": ".github/workflows/ces-dashboard.yml",
      "triggers": [
        "push to ces-dashboard/**",
        "push to specs/ces.yaml"
      ]
    },
    "monitoring": {
      "logs": "console output with FastTrack ID",
      "health_check": "npm run verify-production"
    }
  }
}