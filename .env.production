# CES Production Environment Variables
# Azure PostgreSQL Configuration
CES_AZURE_POSTGRES_URL=postgresql://ces_user@ces-server.postgres.database.azure.com:5432/ces_database?sslmode=require

# Azure OpenAI Configuration for CES
AZURE_OPENAI_API_KEY=placeholder_key
AZURE_OPENAI_ENDPOINT=https://ces-openai.openai.azure.com/
